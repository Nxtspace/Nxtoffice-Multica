@@ -0,0 +1,13 @@
+import { useSyncExternalStore } from 'react';
+import type { SceneModel, SnapshotStore, StoreState, WorkspaceSnapshot } from '../contract';
+import { buildSceneModel } from '../contract';
+
+/** 订阅 store（React 外部状态的唯一桥接） */
+export function useStoreState(store: SnapshotStore): StoreState {
+  return useSyncExternalStore(store.subscribe, store.getState, store.getState);
+}
+
+/** 从快照派生场景模型（两视图共用；useMemo 由调用方保证） */
+export function toSceneModel(snapshot: WorkspaceSnapshot): SceneModel {
+  return buildSceneModel(snapshot);
+}
diff --git a/src/app/session.ts b/src/app/session.ts
new file mode 100644
index 0000000..f2faf0f
--- /dev/null
+++ b/src/app/session.ts
@@ -0,0 +1,32 @@
+/**
+ * mock 会话装配：通道 + store + 场景。切换场景时整体重建，保证不残留旧快照。
+ * 正式适配器接入后，本文件只需替换通道实现（视图与 store 不变）。
+ */
+
+import { SnapshotStore } from '../contract';
+import { MockChannel } from '../mock/channel';
+import { DEMO_THRESHOLDS, type MockScenarioId } from '../mock/scenarios';
+
+export interface MockSession {
+  readonly scenario: MockScenarioId;
+  readonly channel: MockChannel;
+  readonly store: SnapshotStore;
+  dispose(): void;
+}
+
+export function createMockSession(scenario: MockScenarioId): MockSession {
+  const channel = new MockChannel({ scenario });
+  const store = new SnapshotStore({ thresholds: DEMO_THRESHOLDS });
+  store.attach(channel);
+  store.startClock();
+  channel.connect();
+  return {
+    scenario,
+    channel,
+    store,
+    dispose() {
+      store.dispose();
+      channel.dispose();
+    },
+  };
+}
