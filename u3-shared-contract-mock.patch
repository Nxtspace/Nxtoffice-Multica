+    mockAgent('mock-agent-06', '示例 Agent 06 · 建模'),
+    mockAgent('mock-agent-07', '示例 Agent 07 · 产品'),
+    mockAgent('mock-agent-08', '示例 Agent 08 · 技术总监'),
+  ];
+
+  const squads = [
+    mockSquad('mock-squad-01', '示例小队 · 产品研发'),
+    mockSquad('mock-squad-02', '示例小队 · 视觉资产'),
