+/**
+ * mock 固定装置（**仅限隔离开发，不得用于验收放行**）。
+ *
+ * 全部 ID 以 `mock-` 开头、名称带「示例」字样，便于任何截图/日志一眼识别；
+ * 不复制任何真实 Multica 记录（正式数据入口尚未验证，owner CLI 不是生产接口）。
+ */
+
+import {
+  asAgentId,
+  asIssueId,
+  asProjectId,
+  asRunId,
+  asSquadId,
+  asWorkspaceId,
+  assignmentEdgeId,
+  membershipEdgeId,
+  runAssociationEdgeId,
+  type AgentId,
